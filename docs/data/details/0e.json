  "280083837": {
    "item_id": "280083837",
    "listing_url": "https://shopgoodwill.com/item/280083837",
    "images": [
      "https://shopgoodwillimages.azureedge.net/production/145/Items/2026-10-06/6bedaba8-6c33-437a-b909-6077ccd480bbtrgi_10061.jpg",
      "https://shopgoodwillimages.azureedge.net/production/145/Items/2026-10-06/0c1f4ad0-20d9-470f-89a5-9ff6e5e7ed45trgi_10062.jpg",
      "https://shopgoodwillimages.azureedge.net/production/145/Items/2026-10-06/0b25f39e-e954-4c62-9d64-c2e6facceeeatrgi_10063.jpg",
      "https://shopgoodwillimages.azureedge.net/production/145/Items/2026-10-06/d797be31-99f8-4bc3-97b3-0fb11de73b61trgi_10064.jpg",
      "https://shopgoodwillimages.azureedge.net/production/145/Items/2026-10-06/cdc4367a-673e-4561-b864-3d798b2d70b7trgi_10065.jpg",
      "https://shopgoodwillimages.azureedge.net/production/145/Items/2026-10-06/c5f1723b-9df7-4036-81e4-23f236058464trgi_10066.jpg"
