      "https://shopgoodwillimages.azureedge.net/production/119/Items/2026-11-09/a6f9cdc3-cbca-4c42-a2c4-e765b2c8db47ersv_11091.jpg",
      "https://shopgoodwillimages.azureedge.net/production/119/Items/2026-11-09/0f4e2894-86f3-4d9f-b5f6-2179b59caba4ersv_11092.jpg",
      "https://shopgoodwillimages.azureedge.net/production/119/Items/2026-11-09/71e5d23e-5329-4490-ae63-e8f836a4d97cersv_11093.jpg",
