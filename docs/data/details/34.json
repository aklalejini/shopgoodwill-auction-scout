      "https://shopgoodwillimages.azureedge.net/production/145/Items/2026-09-24/4c5aab47-7df9-4463-bb18-a5d86cd1e5f1trgi_09244.jpg",
      "https://shopgoodwillimages.azureedge.net/production/145/Items/2026-09-24/fb17afb2-eaa2-4eeb-b730-b304eab9a5cctrgi_09245.jpg",
