      "https://shopgoodwillimages.azureedge.net/production/145/Items/2026-10-02/80c7afd7-ad4a-484b-804c-07e74116008atrgi_10023.jpg",
      "https://shopgoodwillimages.azureedge.net/production/145/Items/2026-10-02/f44890f8-42cd-4263-92e1-1d2604901cf6trgi_10024.jpg",
