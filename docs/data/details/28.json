    "listing_url": "https://shopgoodwill.com/item/278713102",
    "images": [
      "https://shopgoodwillimages.azureedge.net/production/3/Items/2026-09-14/cc09235c-c697-489c-991d-0cd94ea5de6danes_09141.jpg",
      "https://shopgoodwillimages.azureedge.net/production/3/Items/2026-09-14/6d014d88-2017-4571-b415-ac0134f4eb67anes_09142.jpg",
      "https://shopgoodwillimages.azureedge.net/production/3/Items/2026-09-14/745bbcd1-c47e-4834-a802-6d0edb5db14eanes_09143.jpg",
      "https://shopgoodwillimages.azureedge.net/production/3/Items/2026-09-14/5cbb7d54-4774-4891-83b4-a28db10b2350anes_09144.jpg",
      "https://shopgoodwillimages.azureedge.net/production/3/Items/2026-09-14/60fe81e0-1e31-45a9-96ff-6a4c81d25ad1anes_09145.jpg",
      "https://shopgoodwillimages.azureedge.net/production/3/Items/2026-09-14/b287f87a-8597-4794-942e-58aaeb8f1f13anes_09146.jpg"
